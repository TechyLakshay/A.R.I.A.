# Jarvis
JARVIS_DB_PATH=./data/jarvis.db
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8741
JARVIS_WAKE_SENSITIVITY=0.6
JARVIS_FOLLOWUP_WINDOW_S=60
JARVIS_LOG_LEVEL=INFO
