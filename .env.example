# Copy to .env and fill in as milestones need them.
# M1: nothing required. M3: PICOVOICE_ACCESS_KEY. M4: OPENAI_API_KEY.

# Providers
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
PICOVOICE_ACCESS_KEY=
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
NOTION_TOKEN=
GOOGLE_CLIENT_ID=
