# Copy to .env and fill in as milestones need them.
# M4 (voice loop): OPENAI_API_KEY is required.

# Providers
OPENAI_API_KEY=
DEEPGRAM_API_KEY=
TAVILY_API_KEY=
OPENWEATHER_API_KEY=
NOTION_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# A.R.I.A.
ARIA_DB_PATH=./data/aria.db
ARIA_HOST=127.0.0.1
ARIA_PORT=8741
ARIA_WAKE_MODEL=hey_jarvis            # or path to a custom "hey aria" model from openwakeword.com
ARIA_WAKE_THRESHOLD=0.5
ARIA_VOICE=ash                        # try: ash, echo, verse, alloy…
ARIA_VOICE_FX=1                       # 0 = dry playback (no EQ/reverb chain)
ARIA_FOLLOWUP_WINDOW_S=60
ARIA_LOG_LEVEL=INFO
